# ============================================================================
# Identity Core API - Environment Variables
# ============================================================================

# ============================================================================
# Application Configuration
# ============================================================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_NAME=Identity Core API
APP_VERSION=1.0.0

# ============================================================================
# Database Configuration
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity_core_db
DB_USERNAME=postgres
DB_PASSWORD=<CHANGE_ME>
DB_SCHEMA=public

# Hikari Connection Pool
DB_POOL_SIZE=10
DB_MAX_LIFETIME=600000
DB_CONNECTION_TIMEOUT=30000

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME>
REDIS_DATABASE=0
REDIS_TIMEOUT=5000

# ============================================================================
# JWT Configuration
# ============================================================================
JWT_SECRET=<CHANGE_ME_MIN_256_BITS>
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
JWT_ISSUER=fivucsas-identity-core
JWT_AUDIENCE=fivucsas-clients

# ============================================================================
# Biometric Processor API Integration
# ============================================================================
BIOMETRIC_PROCESSOR_URL=http://localhost:8001
BIOMETRIC_PROCESSOR_API_KEY=<CHANGE_ME>
BIOMETRIC_PROCESSOR_TIMEOUT=60000

# ============================================================================
# Security Configuration
# ============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=*
CORS_MAX_AGE=3600

# Encryption
ENCRYPTION_KEY=<CHANGE_ME_AES256_32_BYTES>
ENCRYPTION_ALGORITHM=AES/GCM/NoPadding

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=100

# ============================================================================
# Multi-Tenancy Configuration
# ============================================================================
MULTITENANCY_ENABLED=true
MULTITENANCY_ISOLATION_LEVEL=ROW_LEVEL
MULTITENANCY_DEFAULT_TENANT=system
MULTITENANCY_TENANT_HEADER=X-Tenant-ID

# ============================================================================
# Logging Configuration
# ============================================================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=DEBUG
LOGGING_LEVEL_SECURITY=DEBUG
LOGGING_LEVEL_SQL=DEBUG
LOGGING_FILE_PATH=logs/identity-core-api.log
LOGGING_FILE_MAX_SIZE=10MB
LOGGING_FILE_MAX_HISTORY=30

# ============================================================================
# Actuator / Monitoring
# ============================================================================
MANAGEMENT_ENDPOINTS_ENABLED=true
MANAGEMENT_PORT=8080
MANAGEMENT_HEALTH_SHOW_DETAILS=always

# ============================================================================
# Email / SMTP Configuration
# ============================================================================
# Required for Email OTP auth handler
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=<CHANGE_ME>
MAIL_PASSWORD=<CHANGE_ME>
MAIL_FROM=noreply@example.com
MAIL_ENABLED=false

# Spring Mail (maps to Spring Boot auto-config)
SPRING_MAIL_HOST=${MAIL_HOST}
SPRING_MAIL_PORT=${MAIL_PORT}
SPRING_MAIL_USERNAME=${MAIL_USERNAME}
SPRING_MAIL_PASSWORD=${MAIL_PASSWORD}

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_EMAIL_VERIFICATION_ENABLED=true
FEATURE_PHONE_VERIFICATION_ENABLED=false
FEATURE_TWO_FACTOR_AUTH_ENABLED=false
FEATURE_SOCIAL_LOGIN_ENABLED=false
