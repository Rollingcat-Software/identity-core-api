# ============================================================================
# Identity Core API - Environment Variables
# ============================================================================

# ============================================================================
# Application Configuration
# ============================================================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_NAME=Identity Core API
APP_VERSION=1.0.0

# ============================================================================
# Database Configuration
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity_core_db
DB_USERNAME=postgres
DB_PASSWORD=<CHANGE_ME>
DB_SCHEMA=public

# Hikari Connection Pool
DB_POOL_SIZE=10
DB_MAX_LIFETIME=600000
DB_CONNECTION_TIMEOUT=30000

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME>
REDIS_DATABASE=0
REDIS_TIMEOUT=5000

# ============================================================================
# JWT Configuration
# ============================================================================
JWT_SECRET=<CHANGE_ME_MIN_256_BITS>
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
JWT_ISSUER=fivucsas-identity-core
JWT_AUDIENCE=fivucsas-clients

# BE-H1 — Dual-algorithm JWT (HS512 + RS256) coexistence.
# Signing algorithm selector. RS256 is the production default since 2026-04-20;
# HS512 remains in verify-only mode for legacy tokens minted during the soak window.
JWT_DEFAULT_ALGO=RS256
# Stable kid advertised in JWKS for the RSA key.
JWT_RSA_KID=rs-2026-04
# RSA 2048 key pair used for RS256. Generate with:
#   openssl genrsa -out jwt_rs256.pem 2048
# Then derive the public key:
#   openssl rsa -in jwt_rs256.pem -pubout -out jwt_rs256.pub
# Paste PEM contents as env values (newline escapes via \n or use docker secrets).
JWT_RSA_PRIVATE_KEY_PEM=
JWT_RSA_PUBLIC_KEY_PEM=

# ============================================================================
# TOTP at-rest encryption (BE-H3, AUDIT_2026-04-19)
# ============================================================================
# AES-GCM-256 key that encrypts users.two_factor_secret at rest.
# Base64-encoded 32 bytes. Generate with:
#   openssl rand -base64 32
# REQUIRED in every environment — the service refuses to boot without it
# (no silent plaintext fallback). Treat like JWT_SECRET: never commit, rotate
# via planned maintenance window.
FIVUCSAS_TOTP_ENC_KEY=<CHANGE_ME_openssl_rand_base64_32>
# Gated re-encryption job for legacy plaintext rows. Flip to `true` during a
# short maintenance window, deploy, observe the `[TotpSecretMigrator] done:`
# log line, then flip back to `false`. See V39__encrypt_totp_secrets.sql.
FIVUCSAS_TOTP_MIGRATE_ON_BOOT=false
# Strict mode (Phase-1 2026-04-20): fail-fast when decryptIfNeeded encounters
# a legacy plaintext row. Enable AFTER the migrator reports zero legacy rows
# AND the V42 CHECK constraint has been applied successfully.
FIVUCSAS_TOTP_REJECT_PLAINTEXT=false

# ============================================================================
# Biometric Processor API Integration
# ============================================================================
BIOMETRIC_PROCESSOR_URL=http://localhost:8001
BIOMETRIC_PROCESSOR_API_KEY=<CHANGE_ME>
BIOMETRIC_PROCESSOR_TIMEOUT=60000

# ============================================================================
# Security Configuration
# ============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=*
CORS_MAX_AGE=3600

# Encryption
ENCRYPTION_KEY=<CHANGE_ME_AES256_32_BYTES>
ENCRYPTION_ALGORITHM=AES/GCM/NoPadding

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=100

# ============================================================================
# Multi-Tenancy Configuration
# ============================================================================
MULTITENANCY_ENABLED=true
MULTITENANCY_ISOLATION_LEVEL=ROW_LEVEL
MULTITENANCY_DEFAULT_TENANT=system
MULTITENANCY_TENANT_HEADER=X-Tenant-ID

# ============================================================================
# Logging Configuration
# ============================================================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=DEBUG
LOGGING_LEVEL_SECURITY=DEBUG
LOGGING_LEVEL_SQL=DEBUG
LOGGING_FILE_PATH=logs/identity-core-api.log
LOGGING_FILE_MAX_SIZE=10MB
LOGGING_FILE_MAX_HISTORY=30

# ============================================================================
# Actuator / Monitoring
# ============================================================================
MANAGEMENT_ENDPOINTS_ENABLED=true
MANAGEMENT_PORT=8080
MANAGEMENT_HEALTH_SHOW_DETAILS=always

# ============================================================================
# Email / SMTP Configuration
# ============================================================================
# Required for Email OTP auth handler
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=<CHANGE_ME>
MAIL_PASSWORD=<CHANGE_ME>
MAIL_FROM=noreply@example.com
MAIL_ENABLED=false

# Spring Mail (maps to Spring Boot auto-config)
SPRING_MAIL_HOST=${MAIL_HOST}
SPRING_MAIL_PORT=${MAIL_PORT}
SPRING_MAIL_USERNAME=${MAIL_USERNAME}
SPRING_MAIL_PASSWORD=${MAIL_PASSWORD}

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_EMAIL_VERIFICATION_ENABLED=true
FEATURE_PHONE_VERIFICATION_ENABLED=false
FEATURE_TWO_FACTOR_AUTH_ENABLED=false
FEATURE_SOCIAL_LOGIN_ENABLED=false
