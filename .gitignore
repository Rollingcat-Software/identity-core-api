# ============================================================================
# Identity Core API (Java/Spring Boot) - .gitignore
# ============================================================================

# Compiled class files
*.class

# Log files
*.log
logs/

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# ============================================================================
# Gradle
# ============================================================================
.gradle
**/build/
!src/**/build/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties
.gradletasknamecache

# ============================================================================
# Maven (if used)
# ============================================================================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ============================================================================
# IDE
# ============================================================================
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.loadpath
.recommenders

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/
*.code-workspace

# ============================================================================
# Spring Boot
# ============================================================================
spring-boot-devtools.properties
application-local.yml
application-local.properties

# ============================================================================
# Environment & Secrets
# ============================================================================
# Catch-all: no env file is ever committed except the checked-in template.
# (Plain `*.env` does NOT match `.env.hetzner` — that gap leaked a stale env
#  file in f9f0f2d; `.env.*` closes it. The dead blob's history purge is tracked
#  as an owner decision in FIVUCSAS#197.)
.env
.env.*
*.env
!.env.example
secrets/
*.pem
*.key
*.crt

# ============================================================================
# Database
# ============================================================================
*.db
*.sqlite
*.sqlite3

# ============================================================================
# OS
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================================================================
# Temporary files
# ============================================================================
*.swp
*.swo
*~

# Node (not used in this project)
node_modules/
package-lock.json

# Production secrets
.env.prod
.env.gcp

# Dated .env.prod backups (host-local rotation/pre-purge snapshots; secrets) — never commit
.env.prod.bak*
.env.*.bak*

# Staging env (host-local; secrets — never commit)
.env.staging

# Claude Code workspace (worktrees, local state) — never commit
.claude/

# Leaked-secret hardening (2026-06-06) — never commit any env file; keep example
.env.hetzner
.env.*
*.env
!.env.example
